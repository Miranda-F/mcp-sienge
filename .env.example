# Copie para .env e preencha. Nunca comite o .env com valores reais.

# --- Sienge (obrigatórias) ---
# Subdomínio: se você acessa https://minhaempresa.sienge.com.br, use "minhaempresa"
SIENGE_SUBDOMAIN=minhaempresa
# Usuário e senha da API, criados no Painel de Integrações do Sienge (não é o login normal)
SIENGE_API_USER=usuario-api
SIENGE_API_PASSWORD=

# --- Modo HTTP (obrigatórias para rodar como servidor) ---
# Tokens de acesso ao MCP: "nome:token", separados por vírgula, com pelo menos 32 caracteres cada.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKENS=openbot:
# Endereço público do servidor, sem barra no final e sem /mcp (usado nos links de CSV)
MCP_PUBLIC_URL=https://sienge-mcp.seudominio.com.br
# Porta HTTP
PORT=3000

# --- Opcionais ---
# Cotas diárias do seu pacote Sienge (ex.: Essencial = 5000 REST / 100 BULK)
# SIENGE_DAILY_QUOTA_REST=5000
# SIENGE_DAILY_QUOTA_BULK=100
# Chamadas por minuto (o Sienge permite 200 REST e 20 BULK por subdomínio)
# SIENGE_RATE_LIMIT_REST=150
# SIENGE_RATE_LIMIT_BULK=15
# Máximo de registros por consulta paginada
# SIENGE_MAX_REGISTROS=1000
# Tempo máximo de cada ferramenta e de cada requisição HTTP, em segundos
# SIENGE_TOOL_TIMEOUT_S=60
# SIENGE_HTTP_TIMEOUT_S=30
# Indexador de correção usado no resumo de contas a pagar
# SIENGE_INDEXADOR_CORRECAO=1
# "nao" desliga a máscara de CPF/RG e dados bancários
# SIENGE_MASCARAR_DADOS=sim
# Log de auditoria ("off" desliga)
# SIENGE_LOG=/data/auditoria.jsonl
